{
  "name": "universal-led-controller",
  "version": "0.4.3",
  "private": true,
  "description": "Universal Windows 10/11 Desktop LED Device Controller (SP530E & WLED)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "desktop:dev": "npm --workspace=@led-controller/desktop run dev",
    "desktop:build": "npm --workspace=@led-controller/desktop run build",
    "desktop:start": "npm --workspace=@led-controller/desktop run start",
    "package:portable": "npm --workspace=@led-controller/desktop run package:portable"
  },
  "author": "Antigravity Autonomous Engineering",
  "license": "MIT"
}
