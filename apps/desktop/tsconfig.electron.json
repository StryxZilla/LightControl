{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../../packages/core/src/*"],
      "@adapters/*": ["../../packages/adapters/src/*"]
    }
  },
  "include": ["src/main", "src/preload"]
}
