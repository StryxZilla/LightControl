{
  "name": "@led-controller/desktop",
  "version": "0.4.2",
  "type": "module",
  "private": true,
  "author": "Universal LED Engineering",
  "description": "Universal Windows 10/11 Desktop LED Device Controller Interface",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "esbuild src/main/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-electron/main.js --external:electron && esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-electron/preload.js --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "package:portable": "npm run build && npx electron-builder --config electron-builder.json --win portable",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "34.5.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
